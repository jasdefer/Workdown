{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workdown.dev/schemas/resources.schema.json",
  "title": "Workdown Resources",
  "description": "Validates the structure of a project's resources.yaml file. Resources are named lists of entities (people, teams, sprints, etc.) that work item fields can reference. The reserved top-level key `constants` holds named scalar values that schema.yaml can reference.",
  "type": ["object", "null"],
  "properties": {
    "constants": {
      "type": ["object", "null"],
      "description": "Named scalar constants defined once per project (a daily rate, a work-hours-per-day convention). Each constant declares a scalar type from the field type system and a value of that type.",
      "patternProperties": {
        "^[a-z_][a-z0-9_]*$": {
          "type": "object",
          "required": ["type", "value"],
          "properties": {
            "type": {
              "description": "Scalar type of this constant's value.",
              "enum": ["string", "integer", "float", "date", "duration", "boolean"]
            },
            "value": {
              "description": "The constant's value. Must match the declared type; dates are YYYY-MM-DD strings, durations use suffix shorthand (\"8h\", \"1w 2d\").",
              "type": ["string", "number", "boolean"]
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "if": { "properties": { "type": { "const": "string" } } },
              "then": { "properties": { "value": { "type": "string" } } }
            },
            {
              "if": { "properties": { "type": { "const": "integer" } } },
              "then": { "properties": { "value": { "type": "integer" } } }
            },
            {
              "if": { "properties": { "type": { "const": "float" } } },
              "then": { "properties": { "value": { "type": "number" } } }
            },
            {
              "if": { "properties": { "type": { "const": "boolean" } } },
              "then": { "properties": { "value": { "type": "boolean" } } }
            },
            {
              "if": { "properties": { "type": { "const": "date" } } },
              "then": {
                "properties": {
                  "value": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
                }
              }
            },
            {
              "if": { "properties": { "type": { "const": "duration" } } },
              "then": { "properties": { "value": { "type": "string" } } }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "patternProperties": {
    "^(?!constants$)[a-z_][a-z0-9_]*$": {
      "type": ["array", "null"],
      "description": "A resource list. Each entry must have a unique id. Other fields are freeform. A null value (all entries commented out) is an empty list.",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier within this resource list. This is the value used in work item fields.",
            "pattern": "^[a-z_][a-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "description": "Human-readable display name."
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
